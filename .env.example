PORT=3000

# MySQL 8 (precisa ser 8.0.16+ por causa dos CHECK)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delivroo
DB_PASSWORD=delivroo
DB_NAME=delivroo2
# usado quando NODE_ENV=test
DB_NAME_TEST=delivroo2_test

JWT_SECRET_STORE=troque-por-um-segredo-longo
JWT_EXPIRES_IN=30d

# Backoffice (admin geral): segredo PRÓPRIO, diferente do da loja. Token expira em 12h por padrão.
JWT_SECRET_ADMIN=troque-por-outro-segredo-longo
# ADMIN_JWT_EXPIRES_IN=12h

# Upload de imagens (Cloudinary) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Tamanho máximo de cada imagem enviada, em MB (padrão 3)
# IMAGE_MAX_MB=3

# Tempo real (SSE) — opcionais
# SSE_HEARTBEAT_MS=25000
# SSE_MAX_PER_CHANNEL=20

# Cobrança manual por Pix — chave do Delivroo mostrada na tela Assinatura das lojas
# BILLING_PIX_KEY=pagamentos@delivroo.app.br
# BILLING_PIX_KEY_TYPE=E-mail
# BILLING_PIX_BENEFICIARY=Delivroo Tecnologia
# BILLING_PIX_INSTRUCTIONS=Após pagar, clique em "Já paguei".
